PORT=8080
FRONTEND_ORIGIN=http://localhost:8080

# Optional automatic online gateway renewal
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
MONTHLY_RENEWAL=299
YEARLY_RENEWAL=1999

# Required for manual UTR verification from the admin panel
ADMIN_ACTIVATION_TOKEN=change-this-to-a-long-random-secret

# Optional email notification when a customer submits renewal UTR
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-email@gmail.com
NOTIFY_EMAIL=your-email@gmail.com
